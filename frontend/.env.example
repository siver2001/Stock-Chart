# Cấu hình kết nối Supabase Cloud Sync cho VN Stock Pro
# Điền SUPABASE_URL và SUPABASE_ANON_KEY từ Dashboard Supabase của bạn vào đây:
# Project Settings -> API -> Project URL & anon/public key

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Tùy chọn: URL Backend API (để trống nếu chạy chung domain)
# VITE_API_URL=http://localhost:8000
